#!/bin/sh
# Auto-refresh cache-bust hashes (style.css/main.js) and sitemap.xml
# lastmod dates before every commit.
#
# One-time setup per clone:   git config core.hooksPath .githooks
# Bypass for one commit:      git commit --no-verify

set -e

staged=$(git diff --cached --name-only)
asset_staged=$(echo "$staged" | grep -E '^(css/style\.css|js/main\.js)$' || true)
html_staged=$(echo "$staged" | grep -E '\.html$' || true)

if [ -z "$asset_staged" ] && [ -z "$html_staged" ]; then
  exit 0
fi

# The helpers write whole files. Refuse partial staging before any mutation,
# otherwise a cache refresh could accidentally commit unrelated user edits.
if [ -n "$asset_staged" ]; then
  unsafe=$(git diff --name-only -- css/style.css js/main.js sitemap.xml '*.html')
else
  unsafe=$(git diff --name-only -- sitemap.xml)
fi
if [ -n "$unsafe" ]; then
  echo "[pre-commit] Cannot safely refresh generated metadata with unstaged changes in:"
  echo "$unsafe"
  echo "Stage or stash those changes, then retry. No helper files were changed."
  exit 1
fi

if [ -n "$asset_staged" ]; then
  echo "[pre-commit] CSS/JS changed -> running bump_assets.py"
  python bump_assets.py
  # Only tracked pages are patched/staged. Untracked drafts remain untouched.
  git ls-files -z -- '*.html' | xargs -0 git add --
fi

if [ -n "$asset_staged" ] || [ -n "$html_staged" ]; then
  echo "[pre-commit] Refreshing sitemap.xml lastmod dates"
  python update_sitemap.py --staged-only
  git add sitemap.xml
fi

exit 0
